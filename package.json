{
  "name": "token-garden",
  "version": "0.0.0",
  "description": "Watch a language model's possible continuations grow as a garden of branches.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.session.json",
    "test": "vitest run",
    "check:size": "node scripts/check-size.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "audit:samples": "node scripts/audit-samples.mjs",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev:worker": "wrangler dev",
    "samples:record": "(test -d tools/record-samples/node_modules || pnpm --dir tools/record-samples install --ignore-workspace --ignore-scripts --frozen-lockfile) && node tools/record-samples/record.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/instrument-serif": "^5",
    "d3-hierarchy": "^3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6",
    "axe-core": "^4.11",
    "happy-dom": "^21.0.3",
    "oxlint": "^1",
    "playwright-core": "^1.64",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "~4.1",
    "wrangler": "~4.86.0"
  }
}
