// token-garden: one Worker serves the SPA (static assets from ./dist) and /api/* (docs/PLAN.md §5.3).
// Deployment is the final phase and needs Sean's approval; locally only `pnpm run check:deploy` (a dry run) is used.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "token-garden",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // No id (PLAN D10): wrangler provisions the namespace on the first real deploy; see docs/DEPLOY.md (phase 13).
  "kv_namespaces": [{ "binding": "TG_CACHE" }],
  // Per-IP limits keyed by CF-Connecting-IP (worker/limits.ts): RL_MISS before an upstream call, RL_ALL on every request.
  "ratelimits": [
    { "name": "RL_MISS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_ALL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // UPSTREAM "openai-compatible" also needs OPENAI_BASE_URL and OPENAI_MODEL here and the secret OPENAI_API_KEY
  // (`wrangler secret put OPENAI_API_KEY`); see docs/EXTENDING.md.
  "vars": {
    "MODEL_ID": "@cf/zai-org/glm-4.7-flash",
    "UPSTREAM": "workers-ai",
    "DAILY_UPSTREAM_CAP": "1000"
  }
}
