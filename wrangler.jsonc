// Reasontrail: one Worker serves the showcase site (static assets from ./dist, headers from public/_headers) and the
// two optional AI endpoints, POST /api/next-tokens (the lens) and POST /api/structure (AI labels), in worker/handler.ts.
// Deployed by Cloudflare Workers Builds from GitHub: build `pnpm run build`, deploy `npx wrangler deploy` (top level =
// production; there are no named environments), branch previews `npx wrangler preview` (the `previews` block below).
// Locally only `pnpm run check:deploy` (a dry run) is used. Runbook: docs/DEPLOY.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reasontrail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; every other path is a static asset (or index.html) with no Worker invocation.
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // No id (PLAN D10): the first deploy (also from Workers Builds) provisions the namespace automatically. Recommended:
  // pin it, so the binding is explicit: `pnpm exec wrangler kv namespace create TG_CACHE`, then add "id": "<printed id>"
  // to this entry (docs/DEPLOY.md, step 3). Never put a placeholder id here: deploy fails on an id that does not exist.
  "kv_namespaces": [{ "binding": "TG_CACHE" }],
  // Per-IP limits keyed by CF-Connecting-IP (worker/limits.ts): RL_MISS before an upstream call, RL_ALL on every request.
  "ratelimits": [
    { "name": "RL_MISS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_ALL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // UPSTREAM "openai-compatible" also needs OPENAI_BASE_URL and OPENAI_MODEL here and the secret OPENAI_API_KEY
  // (`wrangler secret put OPENAI_API_KEY`); see docs/EXTENDING.md and docs/DEPLOY.md.
  "vars": {
    "MODEL_ID": "@cf/zai-org/glm-4.7-flash",
    "UPSTREAM": "workers-ai",
    "DAILY_UPSTREAM_CAP": "1000"
  },
  "observability": { "enabled": true },
  // Workers Builds branch previews (`npx wrangler preview`) inherit none of the bindings above. Previews serve the
  // full site with the AI endpoints switched off (UPSTREAM "off" answers a clear 503, and no AI binding means no model
  // cost), their own rate-limit counters, and no KV, so they never touch production data or the daily budget.
  "previews": {
    "ratelimits": [
      { "name": "RL_MISS", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
      { "name": "RL_ALL", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
    ],
    "vars": {
      "MODEL_ID": "@cf/zai-org/glm-4.7-flash",
      "UPSTREAM": "off",
      "DAILY_UPSTREAM_CAP": "0"
    }
  }
}
