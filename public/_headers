# Response headers for the static site (Cloudflare Workers static assets read this file from ./dist; docs/DEPLOY.md).
# /api/* answers come from the Worker (run_worker_first) and set their own headers. Tested locally with
# `pnpm check:browser --headers`, which serves dist/ through scripts/serve-dist.mjs with these rules applied.
#
# CSP, from what the built app needs: its own scripts, CSS and self-hosted fonts; fetches only to itself (the
# lazy chunks, /viewer.html, /api/*); the intake Web Worker starts from a blob: URL; map cards and downloads use
# blob: URLs; no inline scripts or styles.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output: cache for a year.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The self-contained viewer template ("Save shareable copy" fetches it as text). Opened directly it runs its own
# inline loader, so it gets its own policy: inline only, no network at all. Two patterns because the default
# html_handling redirects /viewer.html to /viewer.
/viewer.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/viewer
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
